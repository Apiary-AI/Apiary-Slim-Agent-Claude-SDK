# Superpos
SUPERPOS_BASE_URL=https://your-superpos-instance.com
SUPERPOS_HIVE_ID=your-hive-id
SUPERPOS_AGENT_ID=your-agent-id
SUPERPOS_API_TOKEN=your-api-token
SUPERPOS_REFRESH_TOKEN=your-refresh-token
SUPERPOS_POLL_INTERVAL=5
# Capabilities and permissions are loaded from /agents/me at boot — no env var.

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ALLOWED_USERS=123456789,987654321
TELEGRAM_CHAT_ID=your-default-chat-id

# OpenAI (for voice message transcription via Whisper)
OPENAI_API_KEY=

# Claude
# Auth: either set ANTHROPIC_API_KEY, or use OAuth by running:
#   docker run -it -v claude_auth:/root/.claude superpos-claude-agent claude
# and opening the printed URL in your browser.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_EFFORT=high
CLAUDE_MAX_TURNS=30
CLAUDE_MAX_PARALLEL=3
CLAUDE_WORKING_DIR=/workspace
# Set to 0/false to disable per-branch worktree isolation (auto-on for git repos).
# CLAUDE_WORKTREE_ISOLATION=1

# Alternative provider: MiniMax (Anthropic-compatible endpoint).
# To route through MiniMax, leave ANTHROPIC_API_KEY blank and set the three
# vars below. The bundled `claude` CLI honors ANTHROPIC_BASE_URL /
# ANTHROPIC_AUTH_TOKEN natively — no code changes needed.
#   ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic   # or .minimaxi.com for CN
#   ANTHROPIC_AUTH_TOKEN=your-minimax-key
#   CLAUDE_MODEL=MiniMax-M2.7
#   ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M2.7
#   ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M2.7
#   ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M2.7

# Alternative provider: Kimi Code (Anthropic-compatible endpoint).
# Requires a Kimi membership with Code benefits; create the key in the Kimi
# Code Console (https://www.kimi.com/code). `kimi-for-coding` is a stable
# model id that auto-maps to Kimi's latest coding model.
#   ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
#   ANTHROPIC_API_KEY=your-kimi-code-key
#   CLAUDE_MODEL=kimi-for-coding
#   CLAUDE_CODE_AUTO_COMPACT_WINDOW=262144
#   ANTHROPIC_DEFAULT_SONNET_MODEL=kimi-for-coding
#   ANTHROPIC_DEFAULT_OPUS_MODEL=kimi-for-coding
#   ANTHROPIC_DEFAULT_HAIKU_MODEL=kimi-for-coding

# Web search on alternative backends. Anthropic's hosted WebSearch/WebFetch
# tools only exist on Anthropic's own API; on any other ANTHROPIC_BASE_URL the
# agent disables them and wires a replacement MCP instead, chosen by:
#   1. WEB_SEARCH_MCP set        -> that server (works on any shim, e.g. Kimi)
#   2. else MINIMAX_API_KEY set  -> MiniMax's own web-search MCP
#   3. else                      -> no web access (coding tasks still work)
# WEB_SEARCH_MCP is a JSON stdio-server config, e.g. Tavily (free tier):
#   WEB_SEARCH_MCP={"command":"npx","args":["-y","tavily-mcp"],"env":{"TAVILY_API_KEY":"tvly-your-key"}}
# MiniMax's MCP is billed against MiniMax Token-Plan credits, so the key is
# kept separate from the model auth token on purpose:
#   MINIMAX_API_KEY=your-minimax-token-plan-key
#   MINIMAX_API_HOST=https://api.minimax.io   # default

# Git / GitHub (for coding tasks: clone, push, PRs)
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com
GITHUB_TOKEN=ghp_your-personal-access-token
